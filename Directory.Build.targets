<Project>
  <!-- Reviewed compile replacements; original FreeSO checkout and pin remain unchanged. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'FSO.Content'">
    <Compile Remove="TS1/TS1NeighbourProvider.cs;TS1/TS1BCFProvider.cs;Framework/TS1Provider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EngineOverrides/FSO.Content/**/*.cs" />
    <_EnhancedBaseSource Include="$(MSBuildProjectDirectory)/TS1/TS1NeighbourProvider.cs"><ExpectedHash>4D363EA96D2BAAD9B3674017A376E5F41E6B99BE0BFB34AE51D9E1BD4A2BF379</ExpectedHash><ExpectedHashCRLF>5626EBC38D1ED370507E5D4460483E7DF5E97F16F9C3DB1D826B613F63C1904E</ExpectedHashCRLF></_EnhancedBaseSource>
    <_EnhancedBaseSource Include="$(MSBuildProjectDirectory)/TS1/TS1BCFProvider.cs"><ExpectedHash>1F478A84BF7C4B47E86017ED43A98FFB0976BD814644F227030DE0ABF4829AF6</ExpectedHash><ExpectedHashCRLF>09C379FF9E18EED915183B213017599A344CB58311949D0262AA01784FC1C3B0</ExpectedHashCRLF></_EnhancedBaseSource>
    <_EnhancedBaseSource Include="$(MSBuildProjectDirectory)/Framework/TS1Provider.cs"><ExpectedHash>98ACA96046C5C7BCA584F60098949BF0CEA39F3A1BEDF693CE4083686380D14B</ExpectedHash><ExpectedHashCRLF>E13C15C3A5F3547AD4F04BC8087E4324749991AB36E65478432D7DB04BA63AEB</ExpectedHashCRLF></_EnhancedBaseSource>
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'FSO.SimAntics'">
    <Compile Remove="Utils/VMTS1PurchasableOutfitHelper.cs;Primitives/VMTS1InventoryOperations.cs;Primitives/VMGenericTS1Call.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EngineOverrides/FSO.SimAntics/**/*.cs" />
    <_EnhancedBaseSource Include="$(MSBuildProjectDirectory)/Utils/VMTS1PurchasableOutfitHelper.cs"><ExpectedHash>6D2110C7778CB643BDE94B28DAD1B9799149E59D0DE8B8E89C6B4D56B02B1289</ExpectedHash><ExpectedHashCRLF>D35299A932B23D2923B76B5692C9934897C2A9BC4C63CC38D4DA0362CD1C396E</ExpectedHashCRLF></_EnhancedBaseSource>
    <_EnhancedBaseSource Include="$(MSBuildProjectDirectory)/Primitives/VMTS1InventoryOperations.cs"><ExpectedHash>C19244AFE34D98FBBAF960749CC0C12B78613F605B903C08E980E837E7395110</ExpectedHash><ExpectedHashCRLF>C20C16C21727DE78123A20E28238D510CA070D24FCF9575D9B0C6BE895C3C487</ExpectedHashCRLF></_EnhancedBaseSource>
    <_EnhancedBaseSource Include="$(MSBuildProjectDirectory)/Primitives/VMGenericTS1Call.cs"><ExpectedHash>2FC6C1BE3D6A077A83CF8D18277D85694C8B4D67512A5C2EFDC21938F0EED3BB</ExpectedHash><ExpectedHashCRLF>1F7260F22CF32E624BABB6D33D449B7794EAE4133F7BC592A3BACE8F0E942274</ExpectedHashCRLF></_EnhancedBaseSource>
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'FSO.Vitaboy'">
    <Compile Remove="CFP.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EngineOverrides/FSO.Vitaboy/**/*.cs" />
    <_EnhancedBaseSource Include="$(MSBuildProjectDirectory)/CFP.cs"><ExpectedHash>8E0E73EB1EE3A3BC30FA27C5DFF68AF211EC639FF8CB826A93AE50830EB17C79</ExpectedHash><ExpectedHashCRLF>B018BE04F909D761198372802A72BDDA4C1DFC15F4673D55AA91D0BB16680FDE</ExpectedHashCRLF></_EnhancedBaseSource>
  </ItemGroup>
  <Target Name="VerifyEnhancedProviderBase" BeforeTargets="CoreCompile" Condition="'@(_EnhancedBaseSource)' != ''">
    <GetFileHash Files="@(_EnhancedBaseSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_EnhancedBaseHash" />
    </GetFileHash>
    <Error Condition="'%(_EnhancedBaseHash.FileHash)' != '%(_EnhancedBaseHash.ExpectedHash)' And '%(_EnhancedBaseHash.FileHash)' != '%(_EnhancedBaseHash.ExpectedHashCRLF)'"
           Text="Pinned FreeSO provider source changed. Review EngineOverrides against the new source before building: %(_EnhancedBaseHash.Identity)" />
  </Target>
</Project>
