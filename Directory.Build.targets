  <Target Name="VerifyEnhancedProviderBase" BeforeTargets="CoreCompile" Condition="'@(_EnhancedBaseSource)' != ''">
    <GetFileHash Files="@(_EnhancedBaseSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_EnhancedBaseHash" />
    </GetFileHash>
    <Error Condition="'%(_EnhancedBaseHash.FileHash)' != '%(_EnhancedBaseHash.ExpectedHash)' And '%(_EnhancedBaseHash.FileHash)' != '%(_EnhancedBaseHash.ExpectedHashCRLF)'"
           Text="Pinned FreeSO provider source changed. Review EngineOverrides against the new source before building: %(_EnhancedBaseHash.Identity)" />
  </Target>
